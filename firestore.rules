rules_version = '2';

// MediTrace Firestore security rules.
//
// Model:
//  - users/{userId}            profile + role, keyed by Firebase Auth uid
//  - doctors/{doctorId}        doctor profile, linked to a user + organization
//  - organizations/{orgId}     hospitals / clinics
//  - patients/{patientId}      patient demographic record
//  - allergies/{id}            patientId-scoped
//  - medications/{id}          patientId-scoped
//  - visits/{id}                patientId-scoped, written by doctors
//  - prescriptions/{id}        patientId-scoped, written by doctors
//  - access_logs/{id}          append-only audit trail
//
// Principles enforced here:
//  1. A patient may only read documents that reference their own patientId.
//  2. A doctor may only read/write clinical documents, never delete them
//     (the longitudinal record must not be erasable from the client).
//  3. Admins manage users/doctors/organizations but do not get blanket
//     access to clinical documents — that boundary is intentional even for
//     admins, and any such access would go through an audited backend
//     process instead of direct client rules.
//  4. Access logs are created by the client but can never be edited or
//     deleted by anyone — they are the audit trail.
//
// This is written for the hackathon prototype's data shape. A production
// deployment would likely also scope doctor access to patients they have an
// explicit authorization/consent record for, rather than "any doctor in the
// system," and would move fan-out writes (log + record together) into a
// Cloud Function to guarantee atomicity and prevent a compromised client
// from writing a false audit entry.

function isSignedIn() {
  return request.auth != null;
}

function userDoc() {
  return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}

function role() {
  return isSignedIn() ? userDoc().role : null;
}

function isDoctor() {
  return role() == 'doctor';
}

function isAdmin() {
  return role() == 'admin';
}

function isPatient() {
  return role() == 'patient';
}

function isOwnPatientRecord(patientId) {
  return isPatient() && userDoc().patientId == patientId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /patients/{patientId} {
      allow read: if isDoctor() || isAdmin() || isOwnPatientRecord(patientId);
      allow create: if isDoctor() || isAdmin();
      allow update: if isDoctor() || isAdmin();
      allow delete: if false;
    }

    match /allergies/{allergyId} {
      allow read: if isDoctor() || isAdmin() || isOwnPatientRecord(resource.data.patientId);
      allow create: if isDoctor();
      allow update: if isDoctor();
      allow delete: if false;
    }

    match /medications/{medicationId} {
      allow read: if isDoctor() || isAdmin() || isOwnPatientRecord(resource.data.patientId);
      allow create: if isDoctor();
      allow update: if isDoctor();
      allow delete: if false;
    }

    match /visits/{visitId} {
      allow read: if isDoctor() || isAdmin() || isOwnPatientRecord(resource.data.patientId);
      allow create: if isDoctor() && request.resource.data.doctorId == userDoc().doctorId;
      allow update: if isDoctor() && resource.data.doctorId == userDoc().doctorId;
      allow delete: if false;
    }

    match /prescriptions/{prescriptionId} {
      allow read: if isDoctor() || isAdmin() || isOwnPatientRecord(resource.data.patientId);
      allow create: if isDoctor() && request.resource.data.doctorId == userDoc().doctorId;
      allow update: if false;
      allow delete: if false;
    }

    match /access_logs/{logId} {
      allow read: if isAdmin() || isOwnPatientRecord(resource.data.patientId) ||
                     (isDoctor() && resource.data.doctorId == userDoc().doctorId);
      allow create: if isDoctor() && request.resource.data.doctorId == userDoc().doctorId;
      allow update: if false;
      allow delete: if false;
    }

    match /drug_interactions/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
