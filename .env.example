# Firebase project configuration.
# Copy this file to .env.local and fill in values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# Never commit .env.local — it is already listed in .gitignore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When true, the app runs entirely on in-memory demo data (src/services/mockData.ts)
# and never calls Firebase. This is the default for local hackathon demos.
VITE_USE_DEMO_DATA=true
